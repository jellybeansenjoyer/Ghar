{
  "project": {
    "name": "Ghar",
    "tagline": "Smart Visitor Notification System for Homes",
    "description": "A cross-platform mobile application that notifies family members in real-time when a visitor arrives. Visitors scan a QR code at the door, fill a lightweight web form (name + photo), and all registered family members receive an instant ringing notification with the ability to accept, reject, or chat with the visitor.",
    "version": "1.0.0",
    "platforms": ["android", "ios"]
  },

  "architecture": {
    "pattern": "Client-Server with Real-time WebSockets",
    "overview": "Flutter mobile app communicates with a custom Node.js/Express backend via REST APIs and Socket.IO. Visitors interact through a lightweight web form served by the same backend. Push notifications are delivered via OneSignal (wrapping FCM/APNs). Photos stored on Cloudinary. PostgreSQL for persistent storage.",
    "layers": {
      "mobile_app": {
        "framework": "Flutter 3.x + Dart",
        "state_management": "Riverpod",
        "navigation": "GoRouter",
        "http_client": "Dio with interceptors",
        "real_time": "Socket.IO client",
        "push_notifications": "OneSignal Flutter SDK + flutter_local_notifications",
        "secure_storage": "flutter_secure_storage"
      },
      "backend_api": {
        "runtime": "Node.js 20 LTS",
        "framework": "Express.js + TypeScript",
        "orm": "Prisma ORM",
        "real_time": "Socket.IO server",
        "validation": "Zod schemas",
        "security": "Helmet, CORS, express-rate-limit"
      },
      "database": {
        "engine": "PostgreSQL 16",
        "hosting": "Neon.tech (serverless, free tier: 512MB)",
        "migrations": "Prisma Migrate"
      },
      "external_services": {
        "push_notifications": "OneSignal (free: 10K subscribers)",
        "sms_otp": "Twilio (free trial $15 credit, then ~$0.01/SMS)",
        "image_storage": "Cloudinary (free: 25GB storage + 25GB bandwidth/mo)",
        "google_auth": "Google OAuth 2.0 (free, unlimited)",
        "hosting": "Railway ($5 free credit/mo) or Render (free tier)"
      }
    }
  },

  "tech_stack": {
    "mobile": {
      "language": "Dart",
      "framework": "Flutter",
      "packages": {
        "dio": "HTTP client with interceptors for API calls",
        "socket_io_client": "Socket.IO for real-time communication",
        "flutter_riverpod": "State management (reactive, testable)",
        "go_router": "Declarative navigation + deep linking",
        "onesignal_flutter": "Push notification SDK",
        "flutter_local_notifications": "Full-screen intent and custom notification display",
        "vibration": "Haptic feedback on visitor arrival",
        "audioplayers": "Play doorbell ringtone sound",
        "qr_flutter": "Generate QR code widget in-app",
        "google_sign_in": "Google OAuth sign-in flow",
        "flutter_secure_storage": "Encrypted token storage on device",
        "cached_network_image": "Efficient image loading and caching",
        "image_picker": "Capture/select profile photo",
        "pinput": "Beautiful OTP input field UI",
        "freezed": "Immutable model classes with code generation",
        "json_serializable": "JSON serialization code generation",
        "intl": "Internationalization and date formatting"
      }
    },
    "backend": {
      "language": "TypeScript",
      "runtime": "Node.js 20 LTS",
      "packages": {
        "express": "HTTP server framework",
        "socket.io": "WebSocket server for real-time events",
        "@prisma/client": "PostgreSQL ORM with type safety",
        "jsonwebtoken": "JWT creation and verification",
        "twilio": "SMS OTP sending service",
        "google-auth-library": "Verify Google ID tokens server-side",
        "cloudinary": "Image upload and transformation SDK",
        "onesignal-node": "OneSignal REST API client for push notifications",
        "express-rate-limit": "Rate limiting middleware",
        "helmet": "Security headers middleware",
        "cors": "Cross-origin resource sharing middleware",
        "zod": "Runtime request/response validation",
        "bcryptjs": "Hashing for refresh tokens",
        "multer": "Multipart form data parsing for photo uploads",
        "node-cron": "Scheduled tasks (visitor auto-expiry)",
        "dotenv": "Environment variable management",
        "uuid": "UUID generation"
      }
    },
    "web_form": {
      "technology": "Vanilla HTML5 + CSS3 + JavaScript (ES6)",
      "description": "Lightweight visitor form served as static files from Express. No build step needed.",
      "features": [
        "Mobile-first responsive design",
        "Camera capture via HTML5 input",
        "Socket.IO client for real-time status updates",
        "Chat interface for visitor-member communication"
      ]
    }
  },

  "database_schema": {
    "tables": {
      "users": {
        "description": "Registered app users (family admins and members)",
        "columns": {
          "id": { "type": "UUID", "primary_key": true, "default": "gen_random_uuid()" },
          "name": { "type": "VARCHAR(255)", "nullable": false },
          "phone": { "type": "VARCHAR(20)", "unique": true, "nullable": true },
          "email": { "type": "VARCHAR(255)", "unique": true, "nullable": true },
          "google_id": { "type": "VARCHAR(255)", "unique": true, "nullable": true },
          "avatar_url": { "type": "TEXT", "nullable": true },
          "family_id": { "type": "UUID", "foreign_key": "families.id", "nullable": true },
          "role": { "type": "VARCHAR(20)", "enum": ["admin", "member"], "default": "member" },
          "onesignal_player_id": { "type": "VARCHAR(255)", "nullable": true },
          "created_at": { "type": "TIMESTAMP", "default": "NOW()" },
          "updated_at": { "type": "TIMESTAMP", "default": "NOW()" }
        }
      },
      "families": {
        "description": "Registered homes/families",
        "columns": {
          "id": { "type": "UUID", "primary_key": true, "default": "gen_random_uuid()" },
          "name": { "type": "VARCHAR(255)", "nullable": false },
          "address": { "type": "TEXT", "nullable": true },
          "admin_id": { "type": "UUID", "foreign_key": "users.id", "nullable": false },
          "qr_code_data": { "type": "TEXT", "description": "The URL encoded in QR code" },
          "created_at": { "type": "TIMESTAMP", "default": "NOW()" }
        }
      },
      "visitors": {
        "description": "Visitor records when someone scans QR and submits form",
        "columns": {
          "id": { "type": "UUID", "primary_key": true, "default": "gen_random_uuid()" },
          "family_id": { "type": "UUID", "foreign_key": "families.id", "nullable": false },
          "name": { "type": "VARCHAR(255)", "nullable": false },
          "photo_url": { "type": "TEXT", "nullable": true },
          "status": { "type": "VARCHAR(20)", "enum": ["pending", "accepted", "rejected", "expired"], "default": "pending" },
          "responded_by": { "type": "UUID", "foreign_key": "users.id", "nullable": true },
          "arrived_at": { "type": "TIMESTAMP", "default": "NOW()" },
          "responded_at": { "type": "TIMESTAMP", "nullable": true }
        }
      },
      "messages": {
        "description": "Chat messages between visitors and family members",
        "columns": {
          "id": { "type": "UUID", "primary_key": true, "default": "gen_random_uuid()" },
          "visitor_id": { "type": "UUID", "foreign_key": "visitors.id", "nullable": false },
          "sender_type": { "type": "VARCHAR(20)", "enum": ["visitor", "member"], "nullable": false },
          "sender_name": { "type": "VARCHAR(255)", "nullable": true },
          "sender_id": { "type": "UUID", "nullable": true, "description": "NULL for visitors, user.id for members" },
          "content": { "type": "TEXT", "nullable": false },
          "sent_at": { "type": "TIMESTAMP", "default": "NOW()" }
        }
      },
      "refresh_tokens": {
        "description": "JWT refresh tokens for authenticated sessions",
        "columns": {
          "id": { "type": "UUID", "primary_key": true, "default": "gen_random_uuid()" },
          "user_id": { "type": "UUID", "foreign_key": "users.id", "nullable": false },
          "token": { "type": "VARCHAR(500)", "nullable": false },
          "expires_at": { "type": "TIMESTAMP", "nullable": false },
          "created_at": { "type": "TIMESTAMP", "default": "NOW()" }
        }
      }
    },
    "relationships": {
      "families_users": "One family has many users (members)",
      "families_visitors": "One family has many visitors",
      "visitors_messages": "One visitor session has many messages",
      "users_refresh_tokens": "One user has many refresh tokens",
      "users_visitors_responded": "A user can respond to many visitors"
    }
  },

  "api_endpoints": {
    "base_url": "/api",
    "auth": {
      "POST /api/auth/send-otp": {
        "description": "Send 6-digit OTP to phone number via Twilio",
        "body": { "phone": "string (E.164 format)" },
        "response": { "message": "OTP sent successfully" },
        "auth_required": false,
        "rate_limit": "3 requests per phone per 5 minutes"
      },
      "POST /api/auth/verify-otp": {
        "description": "Verify OTP and return JWT tokens. Creates user if first-time.",
        "body": { "phone": "string", "otp": "string (6 digits)" },
        "response": { "accessToken": "string", "refreshToken": "string", "user": "User object", "isNewUser": "boolean" },
        "auth_required": false
      },
      "POST /api/auth/google": {
        "description": "Authenticate via Google ID token. Creates user if first-time.",
        "body": { "idToken": "string (Google ID token)" },
        "response": { "accessToken": "string", "refreshToken": "string", "user": "User object", "isNewUser": "boolean" },
        "auth_required": false
      },
      "POST /api/auth/refresh": {
        "description": "Get new access token using refresh token",
        "body": { "refreshToken": "string" },
        "response": { "accessToken": "string" },
        "auth_required": false
      },
      "POST /api/auth/logout": {
        "description": "Revoke refresh token to end session",
        "body": { "refreshToken": "string" },
        "response": { "message": "Logged out successfully" },
        "auth_required": true
      }
    },
    "users": {
      "GET /api/users/me": {
        "description": "Get current authenticated user profile",
        "response": "User object with family details",
        "auth_required": true
      },
      "PUT /api/users/me": {
        "description": "Update user profile (name, avatar)",
        "body": { "name": "string (optional)", "avatarUrl": "string (optional)" },
        "response": "Updated User object",
        "auth_required": true
      }
    },
    "families": {
      "POST /api/families": {
        "description": "Create a new family. Current user becomes admin.",
        "body": { "name": "string", "address": "string (optional)" },
        "response": "Family object with QR code data",
        "auth_required": true
      },
      "GET /api/families/:id": {
        "description": "Get family details (must be a member)",
        "response": "Family object",
        "auth_required": true
      },
      "GET /api/families/:id/members": {
        "description": "List all members of the family",
        "response": "Array of User objects",
        "auth_required": true
      },
      "POST /api/families/:id/members": {
        "description": "Add a member by phone number (admin only). User must exist in system.",
        "body": { "phone": "string" },
        "response": "Added User object",
        "auth_required": true,
        "admin_only": true
      },
      "DELETE /api/families/:id/members/:userId": {
        "description": "Remove a member from family (admin only, cannot remove self)",
        "response": { "message": "Member removed" },
        "auth_required": true,
        "admin_only": true
      },
      "GET /api/families/:id/qr": {
        "description": "Get QR code data (URL) for the family",
        "response": { "qrData": "string (URL)" },
        "auth_required": true
      }
    },
    "visitors": {
      "POST /api/visitors": {
        "description": "Create a new visitor record (from web form, no auth needed). Triggers push notification to all family members.",
        "body": { "familyId": "string (UUID)", "name": "string", "photo": "File (multipart)" },
        "response": { "visitorId": "string", "status": "pending" },
        "auth_required": false,
        "rate_limit": "5 requests per family per 10 minutes"
      },
      "GET /api/families/:id/visitors": {
        "description": "Get visitor history for the family (paginated)",
        "query_params": { "page": "number", "limit": "number" },
        "response": "Paginated array of Visitor objects",
        "auth_required": true
      },
      "GET /api/visitors/:id": {
        "description": "Get visitor details (for family members or the visitor's web form)",
        "response": "Visitor object with photo",
        "auth_required": false
      },
      "POST /api/visitors/:id/respond": {
        "description": "Accept or reject a visitor. Broadcasts status to all members and visitor web form.",
        "body": { "action": "string (accept | reject)" },
        "response": "Updated Visitor object",
        "auth_required": true
      },
      "GET /api/visitors/:id/messages": {
        "description": "Get chat messages for a visitor session",
        "response": "Array of Message objects",
        "auth_required": false
      },
      "POST /api/visitors/:id/messages": {
        "description": "Send a chat message (from member or visitor)",
        "body": { "content": "string", "senderType": "visitor | member", "senderName": "string" },
        "response": "Created Message object",
        "auth_required": false
      }
    },
    "web_form": {
      "GET /visit/:familyId": {
        "description": "Serve the visitor web form (public HTML page)",
        "response": "HTML page",
        "auth_required": false
      }
    }
  },

  "socket_events": {
    "client_to_server": {
      "join:family": {
        "description": "Family member joins their family's Socket.IO room to receive visitor events",
        "payload": { "familyId": "string", "token": "string (JWT)" },
        "emitted_by": "Flutter app on connection"
      },
      "join:visitor": {
        "description": "Visitor web form joins a visitor-specific room for status updates",
        "payload": { "visitorId": "string" },
        "emitted_by": "Visitor web form after submission"
      }
    },
    "server_to_client": {
      "visitor:new": {
        "description": "New visitor arrived - triggers ringing on all family member devices",
        "payload": { "visitorId": "string", "name": "string", "photoUrl": "string", "arrivedAt": "string (ISO)" },
        "sent_to": "Family room"
      },
      "visitor:responded": {
        "description": "A member responded to the visitor - stop ringing on other devices",
        "payload": { "visitorId": "string", "status": "accepted | rejected", "respondedBy": "string (member name)" },
        "sent_to": "Family room"
      },
      "visitor:status": {
        "description": "Visitor status update for the web form",
        "payload": { "status": "accepted | rejected | expired", "respondedBy": "string" },
        "sent_to": "Visitor room"
      },
      "visitor:expired": {
        "description": "Visitor auto-expired after 5 minute timeout",
        "payload": { "visitorId": "string" },
        "sent_to": "Both family room and visitor room"
      },
      "chat:message": {
        "description": "New chat message in a visitor session",
        "payload": { "messageId": "string", "content": "string", "senderType": "visitor | member", "senderName": "string", "sentAt": "string (ISO)" },
        "sent_to": "Visitor room (bidirectional)"
      }
    }
  },

  "push_notification": {
    "provider": "OneSignal",
    "strategy": "Data-only notifications with high priority for full app control",
    "payload": {
      "type": "visitor_arrival",
      "visitorId": "string",
      "visitorName": "string",
      "photoUrl": "string",
      "familyId": "string",
      "familyName": "string"
    },
    "android": {
      "priority": "high",
      "channel": "visitor_alerts",
      "full_screen_intent": true,
      "foreground_service": "Used to keep ringing active",
      "vibration_pattern": "long continuous pattern"
    },
    "ios": {
      "priority": 10,
      "content_available": true,
      "critical_alert": true,
      "sound": "doorbell.caf"
    }
  },

  "authentication": {
    "methods": ["phone_otp", "google_oauth"],
    "phone_otp": {
      "provider": "Twilio",
      "otp_length": 6,
      "otp_expiry_seconds": 300,
      "max_attempts": 3,
      "cooldown_seconds": 60
    },
    "google_oauth": {
      "flow": "Google Sign-In SDK -> ID token -> backend verification",
      "library": "google-auth-library (backend), google_sign_in (Flutter)"
    },
    "tokens": {
      "access_token": {
        "type": "JWT",
        "expiry": "15 minutes",
        "payload": ["userId", "familyId", "role"]
      },
      "refresh_token": {
        "type": "Opaque UUID",
        "expiry": "30 days",
        "storage": "PostgreSQL refresh_tokens table",
        "rotation": true
      }
    }
  },

  "security": {
    "rate_limiting": {
      "otp_send": "3 requests per phone per 5 minutes",
      "otp_verify": "5 attempts per phone per 15 minutes",
      "visitor_create": "5 requests per family per 10 minutes",
      "general_api": "100 requests per IP per 15 minutes"
    },
    "input_validation": "Zod schemas on all endpoints",
    "photo_upload": {
      "max_size_mb": 2,
      "allowed_types": ["image/jpeg", "image/png", "image/webp"],
      "compression": "Cloudinary auto-optimization on upload"
    },
    "cors": {
      "allowed_origins": ["app://", "web form origin"],
      "credentials": true
    },
    "headers": "Helmet middleware for security headers",
    "visitor_expiry": "Auto-expire pending visitors after 5 minutes"
  },

  "user_roles": {
    "admin": {
      "description": "Creator of the family. Full control.",
      "permissions": [
        "create_family",
        "add_members",
        "remove_members",
        "view_visitors",
        "respond_to_visitors",
        "chat_with_visitors",
        "view_qr_code",
        "share_qr_code",
        "delete_family"
      ]
    },
    "member": {
      "description": "Family member added by admin.",
      "permissions": [
        "view_visitors",
        "respond_to_visitors",
        "chat_with_visitors",
        "view_qr_code",
        "leave_family"
      ]
    }
  },

  "app_screens": {
    "splash_screen": {
      "purpose": "App launch, check auth status, navigate accordingly",
      "auto_navigation": {
        "authenticated_with_family": "home_screen",
        "authenticated_no_family": "create_or_join_family_screen",
        "not_authenticated": "login_screen"
      }
    },
    "login_screen": {
      "purpose": "Phone OTP and Google sign-in options",
      "fields": ["phone_number_input"],
      "actions": ["send_otp", "google_sign_in"]
    },
    "otp_verification_screen": {
      "purpose": "Enter 6-digit OTP received via SMS",
      "fields": ["otp_pin_input (6 digits)"],
      "actions": ["verify_otp", "resend_otp"]
    },
    "create_or_join_family_screen": {
      "purpose": "Onboarding: create a new family or wait for admin invite",
      "actions": ["create_family (become admin)", "wait_for_invite (show user's phone)"]
    },
    "home_screen": {
      "purpose": "Main dashboard with family info, quick actions",
      "sections": ["family_name_header", "quick_stats", "recent_visitors_preview"],
      "navigation": ["qr_code_screen", "manage_members_screen", "visitor_history_screen", "profile_screen"]
    },
    "qr_code_screen": {
      "purpose": "Display and share the family QR code",
      "features": ["qr_code_display", "share_qr_image", "download_qr", "print_instructions"]
    },
    "manage_members_screen": {
      "purpose": "View, add, and remove family members",
      "features": ["member_list", "add_member_button (admin)", "remove_member_swipe (admin)", "member_role_display"]
    },
    "add_member_screen": {
      "purpose": "Add family member by phone number",
      "fields": ["phone_number_input"],
      "validation": "Check if user exists in system",
      "error_states": ["user_not_found", "user_already_in_family", "already_a_member"]
    },
    "incoming_visitor_screen": {
      "purpose": "Full-screen ringing notification when visitor arrives",
      "features": ["visitor_photo_large", "visitor_name", "vibration", "ringtone_playing", "accept_button", "reject_button", "chat_button"],
      "behavior": "Launched via full-screen intent (Android) or critical alert (iOS). Overrides lock screen.",
      "auto_dismiss": "When another member responds or visitor expires"
    },
    "visitor_history_screen": {
      "purpose": "List of all past visitors with status",
      "features": ["visitor_list_chronological", "status_badges (accepted/rejected/expired)", "pull_to_refresh", "pagination"],
      "navigation_to": "visitor_detail_screen"
    },
    "visitor_detail_screen": {
      "purpose": "Full visitor details with chat transcript",
      "features": ["visitor_photo", "visitor_name", "arrival_time", "status", "responded_by", "chat_transcript"]
    },
    "chat_screen": {
      "purpose": "Real-time text chat between member and visitor",
      "features": ["message_list", "text_input", "send_button", "real_time_updates_via_socket"]
    },
    "profile_screen": {
      "purpose": "User profile and settings",
      "features": ["name_display", "phone_display", "edit_name", "change_avatar", "notification_settings", "leave_family", "logout"]
    }
  },

  "visitor_web_form": {
    "url_pattern": "/visit/:familyId",
    "pages": {
      "form_page": {
        "purpose": "Visitor enters name and captures photo",
        "fields": ["name_text_input", "photo_capture (camera or gallery)"],
        "submit_action": "POST /api/visitors with multipart form data"
      },
      "waiting_page": {
        "purpose": "Shown after form submission while waiting for response",
        "features": ["loading_animation", "waiting_text", "socket_io_listener_for_status"]
      },
      "response_page": {
        "purpose": "Shows result after family member responds",
        "states": {
          "accepted": "Welcome message with green checkmark",
          "rejected": "Not available message with polite text",
          "expired": "No one responded message with retry option",
          "chat": "Chat interface for messaging with family member"
        }
      }
    },
    "technical": {
      "served_by": "Express static middleware from /public/visit/",
      "socket_io": "Client library loaded from CDN or served locally",
      "no_build_step": "Plain HTML/CSS/JS for maximum simplicity and fast loading"
    }
  },

  "project_structure": {
    "root": {
      "context.json": "This file - project architecture and requirements",
      "server/": "Node.js + Express backend",
      "app/": "Flutter mobile application"
    },
    "server": {
      "src/": {
        "index.ts": "Entry point - starts Express + Socket.IO server",
        "app.ts": "Express app configuration, middleware, routes",
        "config/": {
          "database.ts": "Prisma client initialization",
          "env.ts": "Environment variable validation and export"
        },
        "middleware/": {
          "auth.ts": "JWT verification middleware",
          "error-handler.ts": "Global error handling middleware",
          "rate-limiter.ts": "Rate limiting configurations"
        },
        "routes/": {
          "auth.routes.ts": "Authentication route definitions",
          "user.routes.ts": "User profile route definitions",
          "family.routes.ts": "Family management route definitions",
          "visitor.routes.ts": "Visitor CRUD route definitions"
        },
        "controllers/": {
          "auth.controller.ts": "Auth logic (OTP, Google, tokens)",
          "user.controller.ts": "User profile logic",
          "family.controller.ts": "Family CRUD + member management logic",
          "visitor.controller.ts": "Visitor creation, response, history logic"
        },
        "services/": {
          "otp.service.ts": "Twilio SMS OTP send/verify",
          "google-auth.service.ts": "Google ID token verification",
          "push.service.ts": "OneSignal push notification sending",
          "cloudinary.service.ts": "Image upload to Cloudinary"
        },
        "socket/": {
          "index.ts": "Socket.IO initialization and event routing",
          "visitor.handler.ts": "Visitor arrival/response socket events",
          "chat.handler.ts": "Chat message socket events"
        },
        "validators/": {
          "auth.validator.ts": "Zod schemas for auth endpoints",
          "family.validator.ts": "Zod schemas for family endpoints",
          "visitor.validator.ts": "Zod schemas for visitor endpoints"
        },
        "utils/": {
          "jwt.ts": "JWT sign/verify helper functions",
          "otp.ts": "OTP generation and in-memory store",
          "response.ts": "Standardized API response helpers"
        }
      },
      "prisma/": {
        "schema.prisma": "Database schema definition"
      },
      "public/": {
        "visit/": {
          "index.html": "Visitor web form HTML",
          "style.css": "Visitor web form styles",
          "app.js": "Visitor web form JavaScript logic"
        }
      }
    },
    "app_flutter": {
      "lib/": {
